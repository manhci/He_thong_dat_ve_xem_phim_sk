<%- include('../layout/header') %>

<div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-size: 1.8rem; font-weight: 800; color: #fff;"><%= showtime.event_title %></h1>
    <p style="color: var(--text-muted);">
      🏛️ <%= showtime.venue_name %> | 
      📅 <%= new Date(showtime.starts_at).toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit' }) %> - 
      ⏰ <%= new Date(showtime.starts_at).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %>
    </p>
  </div>
  <a href="/staff" class="btn btn-secondary btn-sm">Quay lại danh sách</a>
</div>

<!-- SEAT OCCUPANCY MAP -->
<h2 style="font-size: 1.3rem; color: var(--accent-gold); margin-bottom: 1rem;">Sơ Đồ Ghế &amp; Người Ngồi</h2>
<div class="seat-grid" style="margin-bottom: 2rem;">
  <% for (let r = 0; r < showtime.rows_count; r++) { 
       const rowChar = String.fromCharCode(65 + r);
  %>
    <div class="seat-row">
      <span class="row-label"><%= rowChar %></span>
      <% for (let c = 1; c <= showtime.seats_per_row; c++) { 
           const seatLabel = rowChar + c;
           const occ = seatOccupantMap[seatLabel];
      %>
        <div class="seat-btn <%= occ ? (occ.status === 'checked_in' ? 'seat-booked' : 'seat-holding') : 'seat-standard' %>"
             title="<%= occ ? (occ.name + ' (' + occ.status + ')') : 'Ghế trống' %>"
             style="cursor: default; <%= occ ? 'background: #0284c7; color: #fff;' : '' %>">
          <%= c %>
        </div>
      <% } %>
      <span class="row-label"><%= rowChar %></span>
    </div>
  <% } %>
</div>

<!-- GUEST LIST TABLE -->
<h2 style="font-size: 1.3rem; color: #fff; margin-bottom: 1rem;">Danh Sách Khách Hàng Đã Đặt Vé (<%= guests.length %> đơn)</h2>
<% if (guests.length === 0) { %>
  <p style="color: var(--text-muted);">Chưa có đơn đặt vé nào cho suất chiếu này.</p>
<% } else { %>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Mã Vé</th>
          <th>Khách Hàng</th>
          <th>Ghế Ngồi</th>
          <th>Tổng Tiền</th>
          <th>Trạng Thái</th>
          <th>Check-in Lúc</th>
        </tr>
      </thead>
      <tbody>
        <% guests.forEach(g => { %>
          <tr>
            <td><strong style="color: var(--accent-gold); font-family: monospace;"><%= g.booking_code %></strong></td>
            <td><%= g.customer_name %><br><span style="font-size: 0.75rem; color: var(--text-muted);"><%= g.customer_email %></span></td>
            <td><strong style="color: var(--accent-cyan);"><%= g.seat_labels %></strong></td>
            <td><%= parseFloat(g.total_amount).toLocaleString('vi-VN') %>đ</td>
            <td>
              <span class="badge-role" style="background: <%= g.status === 'checked_in' ? 'var(--accent-cyan)' : (g.status === 'confirmed' ? 'var(--accent-green)' : '#d97706') %>; color: #fff;">
                <%= g.status %>
              </span>
            </td>
            <td><%= g.checked_in_at ? new Date(g.checked_in_at).toLocaleTimeString('vi-VN') : '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../layout/footer') %>
