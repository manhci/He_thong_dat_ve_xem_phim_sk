<%- include('../layout/header') %>

<h1 style="font-size: 1.8rem; font-weight: 800; color: #fff; margin-bottom: 1.5rem;">
  🎟️ Soát Vé &amp; Check-in Vào Cửa
</h1>

<% if (error) { %>
  <div class="alert alert-error" style="font-size: 1.05rem; font-weight: 600;">
    ❌ <%= error %>
  </div>
<% } %>

<% if (success) { %>
  <div class="alert alert-success" style="font-size: 1.05rem; font-weight: 600;">
    ✅ <%= success %>
  </div>
<% } %>

<div class="form-card" style="max-width: 600px; margin: 0 auto 2rem;">
  <form action="/staff/checkin" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
      <label for="booking_code" style="font-size: 1rem;">Nhập hoặc Quét mã đặt vé (Barcode/QR):</label>
      <input type="text" id="booking_code" name="booking_code" class="form-control" style="font-size: 1.25rem; font-weight: 700; text-align: center; letter-spacing: 2px;" placeholder="VD: BK-XXXXXXXX" required autofocus>
    </div>
    <button type="submit" class="btn btn-primary" style="width: 100%; font-size: 1.05rem; padding: 0.75rem;">
      Xác Nhận Soát Vé
    </button>
  </form>
</div>

<% if (result) { %>
  <div style="max-width: 600px; margin: 0 auto; background: var(--bg-card); border: 2px solid var(--accent-green); border-radius: var(--radius-md); padding: 1.5rem;">
    <h3 style="color: var(--accent-green); font-size: 1.3rem; margin-bottom: 1rem;">
      Thông Tin Vé Đã Check-in Thành Công
    </h3>
    <p style="margin-bottom: 0.5rem; color: #fff;">
      Mã đặt vé: <strong style="font-family: monospace; color: var(--accent-gold); font-size: 1.15rem;"><%= result.booking_code %></strong>
    </p>
    <p style="margin-bottom: 0.5rem; color: #fff;">
      Khách hàng: <strong><%= result.customer_name %></strong>
    </p>
    <p style="margin-bottom: 0.5rem; color: #fff;">
      Sự kiện: <strong><%= result.event_title %></strong>
    </p>
    <p style="margin-bottom: 0.5rem; color: #fff;">
      Phòng chiếu: <strong><%= result.venue_name %></strong>
    </p>
    <p style="margin-bottom: 0.5rem; color: #fff;">
      Giờ chiếu: <strong><%= new Date(result.starts_at).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %></strong>
    </p>
    <div style="margin-top: 1rem; padding: 0.75rem; background: rgba(16, 185, 129, 0.1); border-radius: var(--radius-sm);">
      <span style="font-size: 0.9rem; color: var(--text-muted);">DANH SÁCH GHẾ CHO KHÁCH VÀO CỬA:</span>
      <div style="font-size: 1.4rem; font-weight: 800; color: var(--accent-gold); margin-top: 0.25rem;">
        <%= result.seats.map(s => s.seat_label + ' (' + s.seat_class.toUpperCase() + ')').join(', ') %>
      </div>
    </div>
  </div>
<% } %>

<%- include('../layout/footer') %>
