# ==============================================================================
# CINEMA BOOKING SYSTEM - ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env and fill in strong, unique secrets for production.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=cinemadb
POSTGRES_USER=cinema_app
POSTGRES_PASSWORD=replace_with_strong_password_minimum_16_chars

# Application Database Connection URL
DATABASE_URL=postgres://cinema_app:replace_with_strong_password_minimum_16_chars@db:5432/cinemadb

# Express Session Encryption Secret
SESSION_SECRET=replace_with_random_64_character_hex_secret

# pgAdmin Management Credentials
PGADMIN_DEFAULT_EMAIL=admin@cinema.local
PGADMIN_DEFAULT_PASSWORD=replace_with_strong_pgadmin_password

# Prometheus Exporters Credentials
EXPORTER_PASSWORD=replace_with_strong_exporter_password

# Grafana Administration Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password
