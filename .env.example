# Application Environment
NODE_ENV=production
PORT=3000
SESSION_SECRET=your_jwt_or_session_secret_change_in_production

# PostgreSQL Database
POSTGRES_DB=cinemadb
POSTGRES_USER=cinema_app
POSTGRES_PASSWORD=your_secure_postgres_password_here
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://cinema_app:your_secure_postgres_password_here@db:5432/cinemadb

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@cinema.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here
PGADMIN_PORT=5050

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_password_here
